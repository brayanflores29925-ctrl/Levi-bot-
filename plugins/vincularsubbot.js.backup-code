import fs from 'fs'
import path from 'path'
import pino from 'pino'
import * as Baileys from '@whiskeysockets/baileys'
import { obtenerSubbots, MAX_SUBBOTS } from './subbotmanager.js'
import { vigilarSubbot } from './subbotconexion.js'
import { cargarComandosSubbot, activarComandosSubbot } from './subbotcore.js'

const GRUPO_OFICIAL = '120363405079498012@g.us'
const DATA_FILE = path.join(process.cwd(), 'data', 'subbots.json')
const COOLDOWN_FILE = path.join(process.cwd(), 'data', 'codecooldown.json')

const TIEMPO_CODE = 15 * 60 * 1000
const TIEMPO_ESPERA = 30 * 60 * 1000

const makeWASocket =
  typeof Baileys.default === 'function'
    ? Baileys.default
    : Baileys.makeWASocket

const useMultiFileAuthState =
  Baileys.useMultiFileAuthState ||
  Baileys.default?.useMultiFileAuthState

const delay =
  Baileys.delay ||
  (ms => new Promise(resolve => setTimeout(resolve, ms)))

const Browsers =
  Baileys.Browsers ||
  Baileys.default?.Browsers

function guardar(data) {
  fs.mkdirSync(path.dirname(DATA_FILE), { recursive: true })
  fs.writeFileSync(DATA_FILE, JSON.stringify(data, null, 2))
}

function obtenerCooldowns() {
  try {
    if (!fs.existsSync(COOLDOWN_FILE)) return {}

    const data = JSON.parse(
      fs.readFileSync(COOLDOWN_FILE, 'utf8')
    )

    return data && typeof data === 'object' ? data : {}
  } catch {
    return {}
  }
}

function guardarCooldowns(data) {
  fs.mkdirSync(path.dirname(COOLDOWN_FILE), {
    recursive: true
  })

  fs.writeFileSync(
    COOLDOWN_FILE,
    JSON.stringify(data, null, 2)
  )
}

function limpiarCooldowns() {
  const cooldowns = obtenerCooldowns()
  const ahora = Date.now()
  let cambio = false

  for (const usuario of Object.keys(cooldowns)) {
    if (Number(cooldowns[usuario]) <= ahora) {
      delete cooldowns[usuario]
      cambio = true
    }
  }

  if (cambio) {
    guardarCooldowns(cooldowns)
  }

  return cooldowns
}

function tiempoRestante(ms) {
  const minutos = Math.ceil(ms / 60000)

  if (minutos <= 1) {
    return 'menos de 1 minuto'
  }

  return `${minutos} minutos`
}

export default {
  name: 'code',
  aliases: ['vincularsubbot'],

  async execute(sock, m, parts, enviar) {
    const chatId = m.chat || m.key?.remoteJid
    const sender = m.key?.participant || m.key?.remoteJid

    if (chatId !== GRUPO_OFICIAL) {
      return enviar(
        '❌ Este comando solo está disponible en el grupo oficial de LeviBot.'
      )
    }

    const cooldowns = limpiarCooldowns()
    const bloqueoHasta = cooldowns[sender]

    if (bloqueoHasta && Number(bloqueoHasta) > Date.now()) {
      const restante = Number(bloqueoHasta) - Date.now()

      return enviar(
        '⏳ *ESPERA ANTES DE VOLVER A INTENTAR*\n\n' +
        '❌ Tu código anterior expiró porque no completaste la vinculación.\n\n' +
        `🕐 Debes esperar *${tiempoRestante(restante)}* antes de solicitar otro código.\n\n` +
        '🔄 Cuando termine el tiempo podrás usar *code* nuevamente.'
      )
    }

    const numero = parts?.join('').replace(/\D/g, '')

    if (!numero || numero.length < 10) {
      return enviar(
        '🤖 *CÓDIGO DE SUB-BOT*\n\n' +
        'Escribe el número que quieres vincular.\n\n' +
        'Ejemplo:\n' +
        '/code 504XXXXXXXX'
      )
    }

    const subbots = obtenerSubbots()

    if (subbots.length >= MAX_SUBBOTS) {
      return enviar(
        '🚫 *LÍMITE ALCANZADO*\n\n' +
        `Ya hay *${MAX_SUBBOTS}/${MAX_SUBBOTS}* Sub-Bots registrados.`
      )
    }

    if (subbots.some(s => s.numero === numero)) {
      return enviar(
        '❌ Ese número ya está registrado como Sub-Bot.'
      )
    }

    const carpeta = path.join(
      process.cwd(),
      'data',
      'subbots',
      numero
    )

    fs.mkdirSync(carpeta, { recursive: true })

    let temporizador = null
    let vinculado = false

    try {
      const { state, saveCreds } =
        await useMultiFileAuthState(carpeta)

      const opciones = {
        auth: state,
        logger: pino({ level: 'silent' }),
        printQRInTerminal: false,
        markOnlineOnConnect: false
      }

      if (Browsers) {
        opciones.browser = Browsers.ubuntu('Chrome')
      }

      const subSock = makeWASocket(opciones)

      subSock.ev.on('creds.update', saveCreds)

      vigilarSubbot(subSock, numero, carpeta, {
        parentSock: sock,
        grupo: chatId,
        usuario: sender,
        onOpen: () => {
          vinculado = true

          if (temporizador) {
            clearTimeout(temporizador)
            temporizador = null
          }

          const cooldownsActuales = obtenerCooldowns()

          if (cooldownsActuales[sender]) {
            delete cooldownsActuales[sender]
            guardarCooldowns(cooldownsActuales)
          }
        }
      })

      await cargarComandosSubbot(subSock)
      activarComandosSubbot(subSock)

      await delay(2000)

      const code = await subSock.requestPairingCode(numero)

      const codigo =
        String(code).match(/.{1,4}/g)?.join('-') ||
        String(code)

      const datos = [
        ...subbots,
        {
          numero,
          carpeta,
          agregado: new Date().toISOString(),
          activo: false
        }
      ]

      guardar(datos)

      const jid = m.key.remoteJid

      try {
        const mensaje = Baileys.generateWAMessageFromContent(
          jid,
          {
            viewOnceMessage: {
              message: {
                messageContextInfo: {
                  deviceListMetadataVersion: 2
                },
                interactiveMessage: {
                  body: {
                    text:
                      '📲 *VINCULAR DISPOSITIVO*\\n\\n' +
                      'Toque *Dispositivos vinculados*\\n' +
                      'Luego *Vincular nuevo dispositivo*\\n' +
                      'Selecciona *Vincular con el número de teléfono*\\n\\n' +
                      '📱 Número: *' + numero + '*\\n\\n' +
                      '🔐 *Tu código:*\\n\\n' +
                      codigo + '\\n\\n' +
                      '⏳ Tienes *15 minutos* para completar la vinculación.'
                  },
                  nativeFlowMessage: {
                    buttons: [
                      {
                        name: 'cta_copy',
                        buttonParamsJson: JSON.stringify({
                          display_text: '📋 Copiar código',
                          copy_code: codigo
                        })
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            userJid: sock.user?.id
          }
        )

        await sock.relayMessage(
          jid,
          mensaje.message,
          {
            messageId: mensaje.key.id
          }
        )
      } catch (error) {
        console.log('[LEVI] Botón de copiar no disponible, enviando código normal.')

        await sock.sendMessage(jid, {
          text:
            '📲 *VINCULAR DISPOSITIVO*\\n\\n' +
            '📱 Número: *' + numero + '*\\n\\n' +
            '🔐 *Tu código:*\\n\\n' +
            codigo + '\\n\\n' +
            '⏳ Tienes *15 minutos* para completar la vinculación.'
        })
      }

      temporizador = setTimeout(async () => {
        try {
          if (vinculado) return

          const subbotsActuales = obtenerSubbots()
          const existe = subbotsActuales.some(
            s => s.numero === numero
          )

          if (existe) {
            const datosActualizados =
              subbotsActuales.filter(
                s => s.numero !== numero
              )

            guardar(datosActualizados)
          }

          try {
            subSock.end?.(
              new Error('Código expirado')
            )
          } catch {}

          fs.rmSync(carpeta, {
            recursive: true,
            force: true
          })

          const cooldownsActuales =
            obtenerCooldowns()

          cooldownsActuales[sender] =
            Date.now() + TIEMPO_ESPERA

          guardarCooldowns(cooldownsActuales)

          const mencion =
            sender &&
            sender.endsWith('@s.whatsapp.net')
              ? `@${sender.split('@')[0]}`
              : ''

          await sock.sendMessage(
            chatId,
            {
              text:
                `❌ *ERROR DE VINCULACIÓN*\n\n` +
                `${mencion}\n\n` +
                'No te has podido convertir en Sub-Bot.\n' +
                '⏰ *Tiempo agotado.*\n\n' +
                '🚫 Ahora debes esperar *30 minutos* antes de volver a solicitar un código.\n\n' +
                '🔄 Después del tiempo de espera, vuelve a ingresar *code*.',
              mentions:
                mencion ? [sender] : []
            }
          )
        } catch (error) {
          console.log(
            `[LEVI] Error al expirar código de ${numero}: ${error.message}`
          )
        }
      }, TIEMPO_CODE)

    } catch (error) {
      if (temporizador) {
        clearTimeout(temporizador)
      }

      fs.rmSync(carpeta, {
        recursive: true,
        force: true
      })

      await enviar(
        '❌ No pude generar el código de vinculación.\n\n' +
        `Error: ${error.message}`
      )
    }
  }
}
